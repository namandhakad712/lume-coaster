# Private planning notes, not part of this project's deliverable.
.private/

# Vendored KiCAD MCP server — MIT upstream, not our code, and huge.
# Rebuild from source if you need it; see tools/README.md
tools/kicad-mcp/

# Never commit build output or dependencies anywhere.
node_modules/
dist/
__pycache__/
*.pyc
*.egg-info/

# KiCad: the board files ARE tracked; these are generated by the tooling.
*-backups/
*.sch-bak
*.pcb-bak
fp-info-cache
sym-lib-table
*.kicad_prl
*.kicad_pcb-bak
*.kicad_sch-bak
*-save.kicad_pcb
*-save.kicad_sch

# Gerbers are generated artifacts — release them as archives, not loose files.
*.gbr
*.gbrjob
*.drl
*.drl.tmp
*.zip

# Probe logs and scratch output.
tools/probes/probe-in.txt
tools/probes/probe-out.txt
tools/probes/probe-err.txt

# OS / editor noise.
Thumbs.db
.DS_Store
*.swp
.idea/
.vscode/
